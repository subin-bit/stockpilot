<%- include('../partials/header', { title: title }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <header class="app-topbar">
      <div class="topbar-left">
        <button class="menu-toggle-btn" id="sidebarToggle" aria-label="Open navigation menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div>
          <div class="breadcrumbs">
            <a href="/products">Products</a> &rsaquo;
            <a href="/products/<%= product._id %>"><%= product.name %></a> &rsaquo;
            <span>Edit</span>
          </div>
          <h1 class="page-title">Edit Product</h1>
          <p class="page-subtitle">Update catalog information, SKU, pricing, and thresholds</p>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/products/<%= product._id %>" class="btn btn-secondary">
          &larr; Cancel
        </a>
      </div>
    </header>

    <main class="page-container max-w-4xl">
      <%- include('../partials/messages') %>

      <% 
        const values = (typeof formData !== 'undefined' && formData) ? formData : product;
      %>

      <div class="panel-card form-panel">
        <div class="panel-header">
          <h2 class="panel-title">Product Details</h2>
        </div>

        <form action="/products/<%= product._id %>/update" method="POST" class="form-body">
          <div class="form-grid-2">
            <div class="form-group">
              <label for="name" class="form-label required">Product Name</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                value="<%= values.name || '' %>"
                required
                autofocus
              >
            </div>

            <div class="form-group">
              <label for="sku" class="form-label required">SKU</label>
              <input
                type="text"
                id="sku"
                name="sku"
                class="form-control font-mono uppercase"
                value="<%= values.sku || '' %>"
                required
              >
              <span class="form-hint">Must be globally unique.</span>
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="category" class="form-label required">Category</label>
              <select id="category" name="category" class="form-control" required>
                <% categories.forEach(cat => { %>
                  <% 
                    const isSelected = values.category && (
                      values.category.toString() === cat._id.toString() ||
                      (values.category._id && values.category._id.toString() === cat._id.toString())
                    );
                  %>
                  <option value="<%= cat._id %>" <%= isSelected ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="form-group">
              <label for="price" class="form-label required">Unit Price ($)</label>
              <input
                type="number"
                id="price"
                name="price"
                class="form-control"
                step="0.01"
                min="0"
                value="<%= values.price !== undefined ? values.price : '' %>"
                required
              >
            </div>
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label for="quantity" class="form-label">Current Stock Quantity</label>
              <input
                type="number"
                id="quantity"
                name="quantity"
                class="form-control"
                min="0"
                value="<%= values.quantity !== undefined ? values.quantity : '' %>"
              >
              <span class="form-hint">Direct count override. For audit trail, use Stock In/Out.</span>
            </div>

            <div class="form-group">
              <label for="minStock" class="form-label">Minimum Stock Alert Level</label>
              <input
                type="number"
                id="minStock"
                name="minStock"
                class="form-control"
                min="0"
                value="<%= values.minStock !== undefined ? values.minStock : '' %>"
              >
              <span class="form-hint">Triggers low-stock warnings when inventory reaches this level.</span>
            </div>
          </div>

          <div class="form-actions">
            <a href="/products/<%= product._id %>" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
