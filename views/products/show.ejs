<%- include('../partials/header', { title: title }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <header class="app-topbar">
      <div class="topbar-left">
        <button class="menu-toggle-btn" id="sidebarToggle" aria-label="Open navigation menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div>
          <div class="breadcrumbs">
            <a href="/products">Products</a> &rsaquo; <span><%= product.name %></span>
          </div>
          <h1 class="page-title"><%= product.name %></h1>
        </div>
      </div>

      <div class="topbar-actions">
        <a href="/stock/manage?product=<%= product._id %>" class="btn btn-secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m16 3 4 4-4 4"></path><path d="M20 7H4"></path><path d="m8 21-4-4 4-4"></path><path d="M4 17h16"></path>
          </svg>
          Record Stock In / Out
        </a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/products/<%= product._id %>/edit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
            Edit Product
          </a>
        <% } %>
      </div>
    </header>

    <main class="page-container">
      <%- include('../partials/messages') %>

      <% 
        let statusClass = 'status-in';
        let statusText = 'In Stock';
        let statusColor = 'text-success';
        if (product.quantity === 0) {
          statusClass = 'status-out';
          statusText = 'Out of Stock';
          statusColor = 'text-danger';
        } else if (product.quantity <= product.minStock) {
          statusClass = 'status-low';
          statusText = 'Low Stock';
          statusColor = 'text-warning';
        }
      %>

      <!-- Overview Metric Cards -->
      <section class="metrics-grid">
        <div class="stat-card">
          <div class="stat-details">
            <span class="stat-label">Current Stock Level</span>
            <span class="stat-value <%= statusColor %>"><%= product.quantity %> units</span>
            <span class="stat-trend">
              <span class="badge <%= statusClass %>"><%= statusText %></span>
            </span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-details">
            <span class="stat-label">Unit Price</span>
            <span class="stat-value font-mono">$<%= product.price.toFixed(2) %></span>
            <span class="stat-trend text-muted">Per single unit</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-details">
            <span class="stat-label">Total Inventory Value</span>
            <span class="stat-value font-mono text-cyan">$<%= (product.quantity * product.price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></span>
            <span class="stat-trend text-muted">Qty &times; Unit Price</span>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-details">
            <span class="stat-label">Minimum Reorder Point</span>
            <span class="stat-value"><%= product.minStock %> units</span>
            <span class="stat-trend text-muted">Threshold for alert</span>
          </div>
        </div>
      </section>

      <!-- Details & Specs Panel -->
      <div class="dashboard-columns">
        <div class="panel-card flex-1">
          <div class="panel-header">
            <h2 class="panel-title">Product Specifications</h2>
          </div>
          <div class="panel-body">
            <dl class="meta-list">
              <div class="meta-row">
                <dt>Product Name</dt>
                <dd><strong><%= product.name %></strong></dd>
              </div>
              <div class="meta-row">
                <dt>SKU</dt>
                <dd><code class="sku-tag"><%= product.sku %></code></dd>
              </div>
              <div class="meta-row">
                <dt>Category</dt>
                <dd>
                  <span class="cat-pill"><%= product.category ? product.category.name : 'Uncategorized' %></span>
                </dd>
              </div>
              <div class="meta-row">
                <dt>Created Date</dt>
                <dd class="text-muted"><%= new Date(product.createdAt).toLocaleString() %></dd>
              </div>
              <div class="meta-row">
                <dt>Last Updated</dt>
                <dd class="text-muted"><%= new Date(product.updatedAt).toLocaleString() %></dd>
              </div>
            </dl>

            <% if (currentUser && currentUser.role === 'admin') { %>
              <div class="mt-4 pt-4 border-t flex-align gap-2">
                <a href="/products/<%= product._id %>/edit" class="btn btn-secondary btn-sm">Edit Details</a>
                <form action="/products/<%= product._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Delete this product permanently?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete Product</button>
                </form>
              </div>
            <% } %>
          </div>
        </div>

        <!-- Transaction History for this item -->
        <div class="panel-card flex-2">
          <div class="panel-header">
            <h2 class="panel-title">Recent Stock Movements</h2>
            <a href="/stock/manage?product=<%= product._id %>" class="panel-link">+ Stock Movement</a>
          </div>
          <div class="panel-body p-0">
            <% if (transactions && transactions.length > 0) { %>
              <div class="table-responsive">
                <table class="data-table">
                  <thead>
                    <tr>
                      <th>Type</th>
                      <th class="text-right">Qty</th>
                      <th>Logged By</th>
                      <th>Date</th>
                      <th>Note</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% transactions.forEach(tx => { %>
                      <tr>
                        <td>
                          <span class="badge badge-<%= tx.type === 'IN' ? 'in' : 'out' %>">
                            <%= tx.type === 'IN' ? '↓ Stock IN' : '↑ Stock OUT' %>
                          </span>
                        </td>
                        <td class="text-right">
                          <strong class="<%= tx.type === 'IN' ? 'text-success' : 'text-danger' %> font-mono">
                            <%= tx.type === 'IN' ? '+' : '-' %><%= tx.quantity %>
                          </strong>
                        </td>
                        <td class="text-muted"><%= tx.user ? tx.user.name : 'System' %></td>
                        <td class="text-muted font-mono"><%= new Date(tx.createdAt).toLocaleDateString() %></td>
                        <td class="text-muted"><%= tx.note || '—' %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="empty-state-sm">
                <p class="text-muted">No stock movements recorded for this product yet.</p>
                <a href="/stock/manage?product=<%= product._id %>" class="btn btn-sm btn-outline-primary mt-2">Log Stock Movement</a>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
