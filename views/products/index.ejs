<%- include('../partials/header', { title: 'Products — StockPilot' }) %>

<div class="app-layout">
  <%- include('../partials/sidebar') %>

  <div class="main-wrapper">
    <header class="app-topbar">
      <div class="topbar-left">
        <button class="menu-toggle-btn" id="sidebarToggle" aria-label="Open navigation menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <div>
          <h1 class="page-title">Products Catalog</h1>
          <p class="page-subtitle">Manage inventory items, pricing, SKUs, and stock thresholds</p>
        </div>
      </div>

      <div class="topbar-actions">
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/products/new" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Add New Product
          </a>
        <% } %>
      </div>
    </header>

    <main class="page-container">
      <%- include('../partials/messages') %>

      <!-- Filter / Search Toolbar -->
      <div class="toolbar-card">
        <form action="/products" method="GET" class="filter-form">
          <div class="filter-search-box">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              name="search"
              placeholder="Search by product name or SKU..."
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              class="form-control"
            >
          </div>

          <div class="filter-select-box">
            <select name="category" class="form-control" onchange="this.form.submit()">
              <option value="">All Categories (<%= categories.length %>)</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory.toString() === cat._id.toString()) ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="btn btn-secondary">Filter</button>

          <% if (searchQuery || selectedCategory) { %>
            <a href="/products" class="btn btn-ghost" title="Reset all filters">Clear</a>
          <% } %>
        </form>
      </div>

      <!-- Products Table Panel -->
      <div class="panel-card">
        <div class="panel-header">
          <div class="flex-align gap-2">
            <h2 class="panel-title">Product Inventory</h2>
            <span class="count-pill"><%= products.length %> items</span>
          </div>
        </div>

        <div class="panel-body p-0">
          <% if (products && products.length > 0) { %>
            <div class="table-responsive">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th class="text-right">Price</th>
                    <th class="text-right">Stock</th>
                    <th class="text-right">Min Stock</th>
                    <th class="text-center">Status</th>
                    <th class="text-right">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% products.forEach(prod => { %>
                    <% 
                      let statusClass = 'status-in';
                      let statusText = 'In Stock';
                      if (prod.quantity === 0) {
                        statusClass = 'status-out';
                        statusText = 'Out of Stock';
                      } else if (prod.quantity <= prod.minStock) {
                        statusClass = 'status-low';
                        statusText = 'Low Stock';
                      }
                    %>
                    <tr>
                      <td>
                        <a href="/products/<%= prod._id %>" class="item-link">
                          <strong><%= prod.name %></strong>
                        </a>
                      </td>
                      <td>
                        <code class="sku-tag"><%= prod.sku %></code>
                      </td>
                      <td>
                        <span class="cat-pill">
                          <%= prod.category ? prod.category.name : 'Uncategorized' %>
                        </span>
                      </td>
                      <td class="text-right font-mono">
                        $<%= prod.price.toFixed(2) %>
                      </td>
                      <td class="text-right">
                        <strong class="<%= prod.quantity === 0 ? 'text-danger' : (prod.quantity <= prod.minStock ? 'text-warning' : '') %>">
                          <%= prod.quantity %>
                        </strong>
                      </td>
                      <td class="text-right text-muted font-mono">
                        <%= prod.minStock %>
                      </td>
                      <td class="text-center">
                        <span class="badge <%= statusClass %>">
                          <%= statusText %>
                        </span>
                      </td>
                      <td class="text-right actions-cell">
                        <div class="action-buttons">
                          <a href="/products/<%= prod._id %>" class="btn btn-xs btn-ghost" title="View details">
                            View
                          </a>
                          <a href="/stock/manage?product=<%= prod._id %>" class="btn btn-xs btn-ghost" title="Stock In/Out">
                            Stock
                          </a>
                          <% if (currentUser && currentUser.role === 'admin') { %>
                            <a href="/products/<%= prod._id %>/edit" class="btn btn-xs btn-ghost" title="Edit">
                              Edit
                            </a>
                            <form action="/products/<%= prod._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this product? All transaction history for it will also be removed.');">
                              <button type="submit" class="btn btn-xs btn-ghost text-danger" title="Delete">
                                Delete
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <div class="empty-icon">📦</div>
              <h3>No Products Found</h3>
              <% if (searchQuery || selectedCategory) { %>
                <p>No products match your search or filter criteria.</p>
                <a href="/products" class="btn btn-secondary mt-2">Clear All Filters</a>
              <% } else { %>
                <p>You haven't added any inventory items to the catalog yet.</p>
                <% if (currentUser && currentUser.role === 'admin') { %>
                  <a href="/products/new" class="btn btn-primary mt-2">Add First Product</a>
                <% } %>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
