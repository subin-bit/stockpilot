<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Suppliers Directory</h1>
        <p class="text-muted">Manage your vendor contacts and linked inventory products</p>
      </div>
      <div>
        <a href="/suppliers/new" class="btn btn-primary">+ Add New Supplier</a>
      </div>
    </div>

    <%- include('../partials/messages') %>

    <% if (suppliers && suppliers.length > 0) { %>
      <div class="table-wrapper">
        <table class="table" id="suppliers-table">
          <thead>
            <tr>
              <th>Supplier Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Supplied Items</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% suppliers.forEach((sup) => { %>
              <tr>
                <td>
                  <a href="/suppliers/<%= sup._id %>" style="font-weight: var(--fw-semibold);">
                    <%= sup.name %>
                  </a>
                </td>
                <td><%= sup.email || '—' %></td>
                <td><%= sup.phone || '—' %></td>
                <td>
                  <span class="badge <%= sup.itemCount > 0 ? 'badge-info' : 'badge-warning' %>">
                    <%= sup.itemCount %> item<%= sup.itemCount === 1 ? '' : 's' %>
                  </span>
                </td>
                <td class="text-right">
                  <div class="btn-group" style="justify-content: flex-end;">
                    <a href="/suppliers/<%= sup._id %>" class="btn btn-outline btn-sm">View</a>
                    <a href="/suppliers/<%= sup._id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                    <form action="/suppliers/<%= sup._id %>/delete" method="POST" class="inline-form delete-form">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card empty-state">
        <p>No suppliers registered yet.</p>
        <a href="/suppliers/new" class="btn btn-primary">+ Add Your First Supplier</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
