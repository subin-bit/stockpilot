<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title"><%= supplier.name %></h1>
        <p class="text-muted">Supplier profile and supplied inventory items</p>
      </div>
      <div class="btn-group">
        <a href="/suppliers" class="btn btn-outline">Back to Suppliers</a>
        <a href="/suppliers/<%= supplier._id %>/edit" class="btn btn-primary">Edit Supplier</a>
        <form action="/suppliers/<%= supplier._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this supplier?');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>

    <%- include('../partials/messages') %>

    <div class="card" style="margin-bottom: var(--sp-xl);">
      <div class="card-header">
        <h2 class="card-title">Contact Information</h2>
      </div>

      <div class="detail-row">
        <span class="detail-label">Supplier Name</span>
        <span class="detail-value"><%= supplier.name %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Email</span>
        <span class="detail-value">
          <% if (supplier.email) { %>
            <a href="mailto:<%= supplier.email %>"><%= supplier.email %></a>
          <% } else { %>
            <span class="text-muted">—</span>
          <% } %>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Phone</span>
        <span class="detail-value">
          <% if (supplier.phone) { %>
            <a href="tel:<%= supplier.phone %>"><%= supplier.phone %></a>
          <% } else { %>
            <span class="text-muted">—</span>
          <% } %>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Address</span>
        <span class="detail-value"><%= supplier.address || '—' %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Registered On</span>
        <span class="detail-value"><%= new Date(supplier.createdAt).toLocaleDateString() %></span>
      </div>
    </div>

    <!-- Supplied items table -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Supplied Products (<%= items.length %>)</h2>
        <a href="/items/new" class="btn btn-outline btn-sm">+ Add Item for this Supplier</a>
      </div>

      <% if (items && items.length > 0) { %>
        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th style="width: 50px;">Image</th>
                <th>Name</th>
                <th>SKU</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach((it) => { %>
                <tr>
                  <td>
                    <% if (it.image) { %>
                      <img src="<%= it.image %>" alt="<%= it.name %>" class="thumb" style="width: 36px; height: 36px;">
                    <% } else { %>
                      <div class="thumb thumb-placeholder" style="width: 36px; height: 36px; font-size: 8px;">No img</div>
                    <% } %>
                  </td>
                  <td>
                    <a href="/items/<%= it._id %>" style="font-weight: var(--fw-semibold);">
                      <%= it.name %>
                    </a>
                  </td>
                  <td><code><%= it.sku %></code></td>
                  <td><%= it.category %></td>
                  <td>$<%= it.unitPrice.toFixed(2) %></td>
                  <td><%= it.quantity %></td>
                  <td>
                    <% if (it.isLowStock) { %>
                      <span class="badge badge-warning">Low Stock</span>
                    <% } else { %>
                      <span class="badge badge-success">In Stock</span>
                    <% } %>
                  </td>
                  <td class="text-right">
                    <a href="/items/<%= it._id %>" class="btn btn-outline btn-sm">View Item</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state" style="padding: var(--sp-lg);">
          <p>This supplier currently has no linked items.</p>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
