<!-- views/suppliers/_form.ejs — Shared form partial for suppliers -->
<%
  const getVal = (field, fallback = '') => {
    if (typeof old !== 'undefined' && old[field] !== undefined) {
      return old[field];
    }
    if (typeof supplier !== 'undefined' && supplier && supplier[field] !== undefined) {
      return supplier[field];
    }
    return fallback;
  };
%>

<div class="form-group">
  <label for="name" class="form-label">Supplier Name *</label>
  <input
    type="text"
    id="name"
    name="name"
    class="form-control"
    placeholder="e.g. Acme Tech Components Ltd"
    value="<%= getVal('name') %>"
    required
  >
</div>

<div class="form-row">
  <div class="form-group">
    <label for="email" class="form-label">Email Address</label>
    <input
      type="email"
      id="email"
      name="email"
      class="form-control"
      placeholder="contact@acmetech.com"
      value="<%= getVal('email') %>"
    >
  </div>

  <div class="form-group">
    <label for="phone" class="form-label">Phone Number</label>
    <input
      type="text"
      id="phone"
      name="phone"
      class="form-control"
      placeholder="+1 (555) 234-5678"
      value="<%= getVal('phone') %>"
    >
  </div>
</div>

<div class="form-group">
  <label for="address" class="form-label">Physical Address</label>
  <textarea
    id="address"
    name="address"
    class="form-control"
    rows="3"
    placeholder="123 Warehouse Way, Industrial Zone..."
  ><%= getVal('address') %></textarea>
</div>
