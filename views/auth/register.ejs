<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container auth-wrapper">
    <div class="auth-card">
      <h1>Create an Account</h1>
      <p class="auth-subtitle">Sign up to manage your inventory with StockPilot</p>

      <%- include('../partials/messages') %>

      <form action="/auth/register" method="POST" class="auth-form" id="register-form" novalidate>
        <div class="form-group">
          <label for="name" class="form-label">Full Name</label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-control"
            placeholder="e.g. Jane Doe"
            value="<%= typeof old !== 'undefined' && old.name ? old.name : '' %>"
            required
            autocomplete="name"
          >
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-control"
            placeholder="you@example.com"
            value="<%= typeof old !== 'undefined' && old.email ? old.email : '' %>"
            required
            autocomplete="email"
          >
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="Minimum 6 characters"
            required
            minlength="6"
            autocomplete="new-password"
          >
          <p class="form-hint">Must be at least 6 characters long.</p>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: var(--sp-md);">
          Create Account
        </button>
      </form>

      <p class="auth-footer">
        Already have an account? <a href="/auth/login">Log in here</a>
      </p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
