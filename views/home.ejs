<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="main-content">
  <div class="container">
    <%- include('partials/messages') %>

    <!-- Hero section -->
    <section class="hero" id="hero-section">
      <div class="hero-content">
        <h1 class="hero-title">
          Welcome to <span class="brand-highlight">StockPilot</span>
        </h1>
        <p class="hero-subtitle">
          Your simple, powerful inventory management system.
          Track items, manage suppliers, and keep stock levels in check — all in one place.
        </p>
        <div class="hero-actions">
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <a href="/items" class="btn btn-primary btn-lg">View Inventory</a>
            <a href="/items/new" class="btn btn-outline btn-lg">Add New Item</a>
          <% } else { %>
            <a href="/auth/register" class="btn btn-primary btn-lg">Get Started</a>
            <a href="/auth/login" class="btn btn-outline btn-lg">Login</a>
          <% } %>
        </div>
      </div>

      <!-- Decorative stats preview cards -->
      <div class="hero-cards">
        <div class="stat-card" id="stat-total-items">
          <div class="stat-icon">📦</div>
          <div class="stat-info">
            <span class="stat-value">—</span>
            <span class="stat-label">Total Items</span>
          </div>
        </div>
        <div class="stat-card" id="stat-low-stock">
          <div class="stat-icon">⚠️</div>
          <div class="stat-info">
            <span class="stat-value">—</span>
            <span class="stat-label">Low Stock</span>
          </div>
        </div>
        <div class="stat-card" id="stat-suppliers">
          <div class="stat-icon">🏭</div>
          <div class="stat-info">
            <span class="stat-value">—</span>
            <span class="stat-label">Suppliers</span>
          </div>
        </div>
        <div class="stat-card" id="stat-stock-value">
          <div class="stat-icon">💰</div>
          <div class="stat-info">
            <span class="stat-value">—</span>
            <span class="stat-label">Stock Value</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature highlights -->
    <section class="features" id="features-section">
      <h2 class="section-title">Everything you need</h2>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">🔍</div>
          <h3>Live Search</h3>
          <p>Find any item instantly with real-time Ajax-powered search.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <h3>Dashboard</h3>
          <p>See stock levels, low-stock alerts, and recent activity at a glance.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📥</div>
          <h3>Stock Tracking</h3>
          <p>Record stock in and stock out with full transaction history.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🏷️</div>
          <h3>Manage Items</h3>
          <p>Add, edit, and organise items with images and rich descriptions.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🤝</div>
          <h3>Suppliers</h3>
          <p>Keep supplier details linked to every product you stock.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Secure Access</h3>
          <p>Session-based authentication with encrypted passwords.</p>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('partials/footer') %>
