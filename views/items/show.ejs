<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title"><%= item.name %></h1>
        <p class="text-muted">SKU: <code><%= item.sku %></code></p>
      </div>
      <div class="btn-group">
        <a href="/items" class="btn btn-outline">Back to Items</a>
        <a href="/transactions/new?item=<%= item._id %>" class="btn btn-success">+ Record Movement</a>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
          <a href="/items/<%= item._id %>/edit" class="btn btn-primary">Edit Item</a>
          <form action="/items/<%= item._id %>/delete" method="POST" class="inline-form delete-form">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        <% } %>
      </div>
    </div>

    <%- include('../partials/messages') %>

    <div class="card" style="margin-bottom: var(--sp-xl);">
      <div class="card-header">
        <h2 class="card-title">Item Specifications</h2>
        <% if (item.isLowStock) { %>
          <span class="badge badge-warning">Low Stock Alert</span>
        <% } else { %>
          <span class="badge badge-success">Sufficient Stock</span>
        <% } %>
      </div>

      <!-- Product Image Display -->
      <div style="margin-bottom: var(--sp-lg); display: flex; align-items: center; justify-content: center; background: var(--clr-surface-alt); padding: var(--sp-lg); border-radius: var(--radius-md);">
        <% if (item.image) { %>
          <img src="<%= item.image %>" alt="<%= item.name %>" class="thumb-lg" style="max-height: 280px; object-fit: contain;">
        <% } else { %>
          <div class="thumb-lg thumb-placeholder" style="width: 100%; max-width: 280px; height: 160px; display: flex; align-items: center; justify-content: center;">
            No image uploaded
          </div>
        <% } %>
      </div>

      <div class="detail-row">
        <span class="detail-label">Name</span>
        <span class="detail-value"><%= item.name %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">SKU</span>
        <span class="detail-value"><code><%= item.sku %></code></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Supplier</span>
        <span class="detail-value">
          <% if (item.supplier) { %>
            <a href="/suppliers/<%= item.supplier._id %>" style="font-weight: var(--fw-semibold);">
              <%= item.supplier.name %>
            </a>
          <% } else { %>
            <span class="text-muted">No supplier assigned</span>
          <% } %>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Category</span>
        <span class="detail-value"><%= item.category %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Unit Price</span>
        <span class="detail-value" style="font-weight: var(--fw-semibold); font-size: var(--fs-md); color: var(--clr-primary);">
          $<%= item.unitPrice.toFixed(2) %>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Current Stock</span>
        <span class="detail-value" style="font-weight: var(--fw-bold);">
          <%= item.quantity %> units
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Reorder Level</span>
        <span class="detail-value">
          <%= item.reorderLevel %> units
          <span class="text-muted" style="font-size: var(--fs-xs); margin-left: var(--sp-sm);">
            (triggers warning at or below this count)
          </span>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Added On</span>
        <span class="detail-value"><%= new Date(item.createdAt).toLocaleDateString() %></span>
      </div>

      <% if (item.description) { %>
        <div style="margin-top: var(--sp-lg);">
          <h3 style="font-size: var(--fs-sm); color: var(--clr-text-muted); margin-bottom: var(--sp-sm);">Description</h3>
          <div class="rich-text-content" style="background: var(--clr-surface-alt); padding: var(--sp-md); border-radius: var(--radius-sm); color: var(--clr-text); line-height: 1.6;">
            <!-- Note: <%- %> outputs raw HTML from Quill; script tags are stripped on the server to prevent XSS execution -->
            <%- item.description %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Last 10 Transactions for this item -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Recent Stock Movements</h2>
        <a href="/transactions/new?item=<%= item._id %>" class="btn btn-outline btn-sm">+ Move Stock</a>
      </div>

      <% if (typeof transactions !== 'undefined' && transactions && transactions.length > 0) { %>
        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Units</th>
                <th>User</th>
                <th>Note</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach((tx) => { %>
                <tr>
                  <td><%= new Date(tx.createdAt).toLocaleString() %></td>
                  <td>
                    <% if (tx.type === 'IN') { %>
                      <span class="badge badge-in">Stock IN</span>
                    <% } else { %>
                      <span class="badge badge-out">Stock OUT</span>
                    <% } %>
                  </td>
                  <td style="font-weight: var(--fw-bold);">
                    <%= tx.type === 'IN' ? '+' : '-' %><%= tx.quantity %>
                  </td>
                  <td><%= tx.user ? tx.user.name : '—' %></td>
                  <td><%= tx.note || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state" style="padding: var(--sp-lg);">
          <p>No stock movements recorded for this item yet.</p>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
