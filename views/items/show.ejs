<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title"><%= item.name %></h1>
        <p class="text-muted">SKU: <code><%= item.sku %></code></p>
      </div>
      <div class="btn-group">
        <a href="/items" class="btn btn-outline">Back to Items</a>
        <a href="/items/<%= item._id %>/edit" class="btn btn-primary">Edit Item</a>
        <form action="/items/<%= item._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this item?');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>

    <%- include('../partials/messages') %>

    <div class="card" style="margin-bottom: var(--sp-xl);">
      <div class="card-header">
        <h2 class="card-title">Item Specifications</h2>
        <% if (item.isLowStock) { %>
          <span class="badge badge-warning">Low Stock Alert</span>
        <% } else { %>
          <span class="badge badge-success">Sufficient Stock</span>
        <% } %>
      </div>

      <div class="detail-row">
        <span class="detail-label">Name</span>
        <span class="detail-value"><%= item.name %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">SKU</span>
        <span class="detail-value"><code><%= item.sku %></code></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Category</span>
        <span class="detail-value"><%= item.category %></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Unit Price</span>
        <span class="detail-value" style="font-weight: var(--fw-semibold); font-size: var(--fs-md); color: var(--clr-primary);">
          $<%= item.unitPrice.toFixed(2) %>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Current Stock</span>
        <span class="detail-value" style="font-weight: var(--fw-bold);">
          <%= item.quantity %> units
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Reorder Level</span>
        <span class="detail-value">
          <%= item.reorderLevel %> units
          <span class="text-muted" style="font-size: var(--fs-xs); margin-left: var(--sp-sm);">
            (triggers warning at or below this count)
          </span>
        </span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Added On</span>
        <span class="detail-value"><%= new Date(item.createdAt).toLocaleDateString() %></span>
      </div>

      <% if (item.description) { %>
        <div style="margin-top: var(--sp-lg);">
          <h3 style="font-size: var(--fs-sm); color: var(--clr-text-muted); margin-bottom: var(--sp-sm);">Description</h3>
          <div style="background: var(--clr-surface-alt); padding: var(--sp-md); border-radius: var(--radius-sm); color: var(--clr-text);">
            <p style="white-space: pre-wrap; margin: 0;"><%= item.description %></p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
