<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Inventory Items</h1>
        <p class="text-muted">Manage your stock items, categories, and inventory levels</p>
      </div>
      <div>
        <a href="/items/new" class="btn btn-primary">+ Add New Item</a>
      </div>
    </div>

    <%- include('../partials/messages') %>

    <!-- Filter & search bar -->
    <div class="filter-bar card" style="margin-bottom: var(--sp-lg); padding: var(--sp-md);">
      <form action="/items" method="GET" style="display: flex; gap: var(--sp-md); align-items: center; width: 100%; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: var(--sp-sm);">
          <label for="category-filter" class="form-label" style="margin-bottom: 0;">Filter by Category:</label>
          <select name="category" id="category-filter" class="form-control" style="width: auto; min-width: 180px;" onchange="this.form.submit()">
            <option value="">All Categories</option>
            <% categories.forEach((cat) => { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }); %>
          </select>
        </div>

        <% if (selectedCategory) { %>
          <a href="/items" class="btn btn-outline btn-sm">Clear Filter</a>
        <% } %>
      </form>
    </div>

    <% if (items && items.length > 0) { %>
      <div class="table-wrapper">
        <table class="table" id="items-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>SKU</th>
              <th>Category</th>
              <th>Price</th>
              <th>Quantity</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((item) => { %>
              <tr data-quantity="<%= item.quantity %>" data-reorder="<%= item.reorderLevel %>" class="<%= item.isLowStock ? 'low-stock' : '' %>">
                <td>
                  <a href="/items/<%= item._id %>" style="font-weight: var(--fw-semibold);">
                    <%= item.name %>
                  </a>
                </td>
                <td><code><%= item.sku %></code></td>
                <td><%= item.category %></td>
                <td>$<%= item.unitPrice.toFixed(2) %></td>
                <td><%= item.quantity %></td>
                <td>
                  <% if (item.isLowStock) { %>
                    <span class="badge badge-warning">Low Stock (≤ <%= item.reorderLevel %>)</span>
                  <% } else { %>
                    <span class="badge badge-success">In Stock</span>
                  <% } %>
                </td>
                <td class="text-right">
                  <div class="btn-group" style="justify-content: flex-end;">
                    <a href="/items/<%= item._id %>" class="btn btn-outline btn-sm">View</a>
                    <a href="/items/<%= item._id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                    <form action="/items/<%= item._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this item?');">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card empty-state">
        <p>No inventory items found <%= selectedCategory ? `in category "${selectedCategory}"` : '' %>.</p>
        <a href="/items/new" class="btn btn-primary">+ Add Your First Item</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
