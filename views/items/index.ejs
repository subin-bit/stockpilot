<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-content">
  <div class="container">
    <div class="page-header">
      <div>
        <h1 class="page-title">Inventory Items</h1>
        <p class="text-muted">Manage your stock items, categories, and inventory levels</p>
      </div>
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
        <div>
          <a href="/items/new" class="btn btn-primary">+ Add New Item</a>
        </div>
      <% } %>
    </div>

    <%- include('../partials/messages') %>

    <!-- Filter & search bar -->
    <div class="filter-bar card" style="margin-bottom: var(--sp-lg); padding: var(--sp-md);">
      <div style="display: flex; gap: var(--sp-lg); align-items: center; width: 100%; flex-wrap: wrap;">
        <!-- Client-side Category Filter (built dynamically with JS Set & Map) -->
        <div style="display: flex; align-items: center; gap: var(--sp-sm);">
          <label for="client-category-filter" class="form-label" style="margin-bottom: 0;">Quick Filter:</label>
          <select id="client-category-filter" class="form-control" style="width: auto; min-width: 180px;">
            <option value="ALL">All Categories</option>
          </select>
        </div>

        <!-- Server-side Category Filter fallback -->
        <form action="/items" method="GET" style="display: flex; gap: var(--sp-sm); align-items: center;">
          <select name="category" id="category-filter" class="form-control" style="width: auto; min-width: 160px; font-size: var(--fs-xs);">
            <option value="">Server Filter...</option>
            <% categories.forEach((cat) => { %>
              <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>>
                <%= cat %>
              </option>
            <% }); %>
          </select>
          <button type="submit" class="btn btn-outline btn-sm">Filter</button>
          <% if (selectedCategory) { %>
            <a href="/items" class="btn btn-outline btn-sm">Clear</a>
          <% } %>
        </form>

        <!-- Ajax Live Search (Phase 6) -->
        <div style="flex: 1; min-width: 260px; display: flex; align-items: center; gap: var(--sp-sm);">
          <input
            type="text"
            id="live-search"
            class="form-control"
            placeholder="Live search by name, SKU, category..."
            autocomplete="off"
          >
          <span id="search-loading" class="loading" style="display: none;">Searching...</span>
        </div>
      </div>
    </div>

    <!-- Ajax Item Quick View Panel (Phase 6) -->
    <div id="quick-view-panel" class="quick-view">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--sp-md);">
        <div>
          <h2 id="qv-name" style="font-size: var(--fs-lg); margin-bottom: 2px;">Item Quick View</h2>
          <span id="qv-status-badge" class="badge"></span>
        </div>
        <button type="button" id="quick-view-close" class="btn btn-outline btn-sm">✕ Close</button>
      </div>

      <div class="detail-grid" style="grid-template-columns: 140px 1fr; gap: var(--sp-lg);">
        <div id="qv-image-container" style="display: flex; align-items: center; justify-content: center; background: var(--clr-surface-alt); border-radius: var(--radius-sm); padding: var(--sp-sm);">
          <img id="qv-image" src="" alt="Item Image" class="thumb-lg" style="width: 120px; height: 120px; object-fit: contain;">
        </div>

        <div>
          <div class="detail-row">
            <span class="detail-label">SKU:</span>
            <span class="detail-value"><code id="qv-sku"></code></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Category:</span>
            <span class="detail-value" id="qv-category"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Price:</span>
            <span class="detail-value" id="qv-price" style="font-weight: var(--fw-bold); color: var(--clr-primary);"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Current Stock:</span>
            <span class="detail-value" id="qv-stock"></span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Supplier:</span>
            <span class="detail-value" id="qv-supplier"></span>
          </div>
          <div id="qv-description-row" style="margin-top: var(--sp-sm);">
            <span class="detail-label" style="display: block; margin-bottom: 4px;">Description:</span>
            <div id="qv-description" class="rich-text-content text-muted" style="font-size: var(--fs-xs); line-height: 1.5; max-height: 120px; overflow-y: auto;"></div>
          </div>
          <div style="margin-top: var(--sp-md); display: flex; gap: var(--sp-sm);">
            <a id="qv-full-link" href="#" class="btn btn-primary btn-sm">Full Details Page →</a>
            <a id="qv-restock-link" href="#" class="btn btn-success btn-sm">+ Move Stock</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Search No Results Alert -->
    <div id="search-no-results" class="card empty-state" style="display: none; margin-bottom: var(--sp-lg);">
      <p>No inventory items match your search.</p>
    </div>

    <% if (items && items.length > 0) { %>
      <div class="table-wrapper">
        <table class="table" id="items-table" data-user-role="<%= typeof currentUser !== 'undefined' && currentUser ? currentUser.role : 'user' %>">
          <thead>
            <tr>
              <th style="width: 60px;">Image</th>
              <th class="sortable" data-type="text">Name</th>
              <th class="sortable" data-type="text">SKU</th>
              <th class="sortable" data-type="text">Category</th>
              <th class="sortable" data-type="number">Price</th>
              <th class="sortable" data-type="number">Quantity</th>
              <th class="sortable" data-type="text">Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((item) => { %>
              <tr data-quantity="<%= item.quantity %>" data-reorder="<%= item.reorderLevel %>" data-category="<%= item.category %>" class="<%= item.isLowStock ? 'low-stock' : '' %>">
                <td>
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" alt="<%= item.name %>" class="thumb">
                  <% } else { %>
                    <div class="thumb thumb-placeholder">No img</div>
                  <% } %>
                </td>
                <td>
                  <a href="/items/<%= item._id %>" style="font-weight: var(--fw-semibold);">
                    <%= item.name %>
                  </a>
                </td>
                <td><code><%= item.sku %></code></td>
                <td><%= item.category %></td>
                <td>$<%= item.unitPrice.toFixed(2) %></td>
                <td><%= item.quantity %></td>
                <td>
                  <% if (item.isLowStock) { %>
                    <span class="badge badge-warning">Low Stock (≤ <%= item.reorderLevel %>)</span>
                  <% } else { %>
                    <span class="badge badge-success">In Stock</span>
                  <% } %>
                </td>
                <td class="text-right">
                  <div class="btn-group" style="justify-content: flex-end;">
                    <button type="button" class="btn btn-outline btn-sm btn-quick-view" data-id="<%= item._id %>">Quick</button>
                    <a href="/items/<%= item._id %>" class="btn btn-outline btn-sm">View</a>
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
                      <a href="/items/<%= item._id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                      <form action="/items/<%= item._id %>/delete" method="POST" class="inline-form delete-form">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card empty-state">
        <p>No inventory items found <%= selectedCategory ? `in category "${selectedCategory}"` : '' %>.</p>
        <a href="/items/new" class="btn btn-primary">+ Add Your First Item</a>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
