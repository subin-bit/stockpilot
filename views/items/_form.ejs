<!-- views/items/_form.ejs — Shared form partial with Image Upload and Quill WYSIWYG Editor -->
<%
  const getVal = (field, fallback = '') => {
    if (typeof old !== 'undefined' && old[field] !== undefined) {
      return old[field];
    }
    if (typeof item !== 'undefined' && item && item[field] !== undefined) {
      return item[field];
    }
    return fallback;
  };
%>

<div class="form-row">
  <div class="form-group">
    <label for="name" class="form-label">Item Name *</label>
    <input
      type="text"
      id="name"
      name="name"
      class="form-control"
      placeholder="e.g. Wireless Ergonomic Mouse"
      value="<%= getVal('name') %>"
      required
    >
  </div>

  <div class="form-group">
    <label for="sku" class="form-label">SKU (Stock Keeping Unit) *</label>
    <input
      type="text"
      id="sku"
      name="sku"
      class="form-control"
      placeholder="e.g. WEM-001"
      value="<%= getVal('sku') %>"
      required
      style="text-transform: uppercase;"
    >
    <p class="form-hint">Unique identifier, automatically converted to uppercase.</p>
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <label for="category" class="form-label">Category</label>
    <input
      type="text"
      id="category"
      name="category"
      class="form-control"
      placeholder="e.g. Peripherals, Office, Electronics"
      value="<%= getVal('category', 'General') %>"
    >
  </div>

  <div class="form-group">
    <label for="unitPrice" class="form-label">Unit Price ($) *</label>
    <input
      type="number"
      id="unitPrice"
      name="unitPrice"
      class="form-control"
      placeholder="0.00"
      step="0.01"
      min="0"
      value="<%= getVal('unitPrice') %>"
      required
    >
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <label for="quantity" class="form-label">Current Quantity</label>
    <input
      type="number"
      id="quantity"
      name="quantity"
      class="form-control"
      placeholder="0"
      min="0"
      value="<%= getVal('quantity', 0) %>"
    >
  </div>

  <div class="form-group">
    <label for="reorderLevel" class="form-label">Reorder Level</label>
    <input
      type="number"
      id="reorderLevel"
      name="reorderLevel"
      class="form-control"
      placeholder="5"
      min="0"
      value="<%= getVal('reorderLevel', 5) %>"
    >
    <p class="form-hint">Alert triggers when quantity drops to or below this level.</p>
  </div>
</div>

<!-- Image upload field -->
<div class="form-group">
  <label for="image" class="form-label">Product Image</label>
  <% if (typeof item !== 'undefined' && item && item.image) { %>
    <div style="display: flex; align-items: center; gap: var(--sp-md); margin-bottom: var(--sp-sm);">
      <img src="<%= item.image %>" alt="<%= item.name %>" class="thumb" style="width: 54px; height: 54px;">
      <span class="text-muted" style="font-size: var(--fs-xs);">Current image (upload a new file below to replace)</span>
    </div>
  <% } %>
  <input
    type="file"
    id="image"
    name="image"
    class="form-control form-control-file"
    accept="image/*"
  >
  <p class="form-hint">Allowed formats: JPG, PNG, GIF, WebP (max 2 MB). Note: image must be reselected if form encounters validation errors.</p>
</div>

<!-- WYSIWYG Description field -->
<div class="form-group">
  <label class="form-label">Description (Rich Text)</label>
  <!-- Hidden input that submits HTML to req.body.description -->
  <input
    type="hidden"
    name="description"
    id="hidden-description"
    value="<%= getVal('description') %>"
  >
  <!-- Quill editor wrapper -->
  <div style="background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-sm); overflow: hidden;">
    <div id="quill-editor" style="min-height: 160px; font-family: var(--font-family); font-size: var(--fs-base); color: var(--clr-text);"></div>
  </div>
</div>

<!-- Initialize Quill editor script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Only initialize if Quill is loaded
    if (typeof Quill === 'undefined') return;

    const quill = new Quill('#quill-editor', {
      theme: 'snow',
      placeholder: 'Enter a formatted description of this inventory item...',
      modules: {
        toolbar: [
          [{ 'header': [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          [{ 'list': 'ordered'}, { 'list': 'bullet' }],
          ['clean']
        ]
      }
    });

    const hiddenInput = document.getElementById('hidden-description');

    // Preload existing description if available
    if (hiddenInput && hiddenInput.value) {
      quill.root.innerHTML = hiddenInput.value;
    }

    // On form submission, sync Quill HTML content into hidden input
    const parentForm = document.getElementById('item-form');
    if (parentForm) {
      parentForm.addEventListener('submit', () => {
        const content = quill.root.innerHTML;
        // Don't save empty paragraph tag if user left it empty
        hiddenInput.value = (content === '<p><br></p>') ? '' : content;
      });
    }
  });
</script>
