<!-- views/items/_form.ejs — Shared form partial for item creation and editing -->
<%
  const getVal = (field, fallback = '') => {
    if (typeof old !== 'undefined' && old[field] !== undefined) {
      return old[field];
    }
    if (typeof item !== 'undefined' && item && item[field] !== undefined) {
      return item[field];
    }
    return fallback;
  };
%>

<div class="form-row">
  <div class="form-group">
    <label for="name" class="form-label">Item Name *</label>
    <input
      type="text"
      id="name"
      name="name"
      class="form-control"
      placeholder="e.g. Wireless Ergonomic Mouse"
      value="<%= getVal('name') %>"
      required
    >
  </div>

  <div class="form-group">
    <label for="sku" class="form-label">SKU (Stock Keeping Unit) *</label>
    <input
      type="text"
      id="sku"
      name="sku"
      class="form-control"
      placeholder="e.g. WEM-001"
      value="<%= getVal('sku') %>"
      required
      style="text-transform: uppercase;"
    >
    <p class="form-hint">Unique identifier, saved in uppercase.</p>
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <label for="category" class="form-label">Category</label>
    <input
      type="text"
      id="category"
      name="category"
      class="form-control"
      placeholder="e.g. Peripherals, Office, Electronics"
      value="<%= getVal('category', 'General') %>"
    >
  </div>

  <div class="form-group">
    <label for="unitPrice" class="form-label">Unit Price ($) *</label>
    <input
      type="number"
      id="unitPrice"
      name="unitPrice"
      class="form-control"
      placeholder="0.00"
      step="0.01"
      min="0"
      value="<%= getVal('unitPrice') %>"
      required
    >
  </div>
</div>

<div class="form-row">
  <div class="form-group">
    <label for="quantity" class="form-label">Current Quantity</label>
    <input
      type="number"
      id="quantity"
      name="quantity"
      class="form-control"
      placeholder="0"
      min="0"
      value="<%= getVal('quantity', 0) %>"
    >
  </div>

  <div class="form-group">
    <label for="reorderLevel" class="form-label">Reorder Level</label>
    <input
      type="number"
      id="reorderLevel"
      name="reorderLevel"
      class="form-control"
      placeholder="5"
      min="0"
      value="<%= getVal('reorderLevel', 5) %>"
    >
    <p class="form-hint">Alert triggers when quantity drops to or below this level.</p>
  </div>
</div>

<div class="form-group">
  <label for="description" class="form-label">Description</label>
  <textarea
    id="description"
    name="description"
    class="form-control"
    rows="4"
    placeholder="Enter detailed description of the item..."
  ><%= getVal('description') %></textarea>
</div>
